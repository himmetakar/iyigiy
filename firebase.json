{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "key.txt",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "assets/gen/**",
      ".claude/**"
    ],
    "headers": [
      { "source": "**/*.@(jpg|png|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  }
}
